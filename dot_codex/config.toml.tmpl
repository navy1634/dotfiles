model = {{ .codex_model | quote }}
model_reasoning_effort = "max"
default_permissions = "workspace-no-env"
approval_policy = "on-request"
approvals_reviewer = "user"
service_tier = "default"

[features]
multi_agent = true
memories = true
workspace_dependencies = false

[tui]
status_line = ["model-with-reasoning", "current-dir", "git-branch", "five-hour-limit", "weekly-limit", "context-used", "used-tokens", "total-input-tokens", "total-output-tokens"]
status_line_use_colors = true

[desktop]
dock-icon-preference = "codex-system"
usePointerCursors = false
appshotSoundEnabled = false
conversationDetailMode = "STEPS_PROSE"
git-pr-instructions = "テンプレートに従うこと"
git-commit-instructions = "対応内容を短く簡潔に"
enabled-reasoning-efforts = ["low", "medium", "high", "xhigh", "ultra", "max"]
projectlessWorkspaceRoot = "{{ .chezmoi.homeDir }}/Documents/github.com/sandbox/codex"
localeOverride = "ja-JP"
ambient-suggestions-enabled = false
followUpQueueMode = "steer"
composerEnterBehavior = "cmdAlways"
show-context-window-usage = true
composerPlainTextMode = true
git-branch-prefix = ""

[permissions.workspace-no-env]
extends = ":workspace"

[permissions.workspace-no-env.filesystem]
glob_scan_max_depth = 10

[permissions.workspace-no-env.filesystem.":workspace_roots"]
"**/.env" = "deny"
"**/.env.*" = "deny"

[permissions.workspace-no-env.network]
enabled = true

[memories]
generate_memories = true
use_memories = true

[marketplaces.openai-bundled]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.codex/.tmp/bundled-marketplaces/openai-bundled"

[marketplaces.agent-toolbox]
source_type = "git"
source = "https://github.com/navy1634/plugin-agent-toolbox.git"
ref = "main"

[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."sites@openai-bundled"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."agent-toolbox@agent-toolbox"]
enabled = true

[plugins."planning-review-docs@agent-toolbox"]
enabled = true

[plugins."coding-workflow@agent-toolbox"]
enabled = true

[plugins."specialized@agent-toolbox"]
enabled = true

[plugins."general-tools@agent-toolbox"]
enabled = true
