// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "sidebar_side": "right"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "auto_signature_help": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_fallbacks": [
    "Monaco",
    "Courier New",
    "monospace",
    "Hack Nerd Font"
  ],
  "buffer_font_family": "Menlo",
  // こっちはコードを書く部分の設定
  "buffer_font_size": 14,
  // 行間を VS Code と同等にする
  "buffer_line_height": {
    "custom": 1.3
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": true
    },
    "provider": "copilot"
  },
  "file_types": {
    "latex": [
      "*.pdf"
    ]
  },
  "format_on_save": "on",
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "icon_theme": "Material Icon Theme",
  "languages": {
    "CSS": {
      "formatter": {
        "external": {
          "arguments": [
            "format",
            "--stdin-file-path",
            "{buffer_path}"
          ],
          "command": "biome"
        }
      },
      "language_servers": [
        "biome"
      ]
    },
    "Go": {
      "code_actions_on_format": {
        "source.fixAll": true
      },
      "formatter": "language_server",
      "language_servers": [
        "gopls",
        "golangci-lint-langserver"
      ],
      "tab_size": 4
    },
    "HTML": {
      "formatter": {
        "external": {
          "arguments": [
            "format",
            "--stdin-file-path",
            "{buffer_path}"
          ],
          "command": "biome"
        }
      },
      "language_servers": [
        "biome"
      ],
      "tab_size": 2
    },
    "JSON": {
      "formatter": "language_server",
      "language_servers": [
        "biome",
        "json-language-server"
      ]
    },
    "JSONC": {
      "formatter": "language_server", // これで外部コマンドではなく LSP に任せる
      "language_servers": [
        "biome",
        "json-language-server"
      ]
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll": true
      },
      "formatter": {
        "external": {
          "arguments": [
            "format",
            "--stdin-file-path",
            "{buffer_path}"
          ],
          "command": "biome"
        }
      },
      // vtsls を完全にオフにすると、Biome ではカバーしきれない高度な型推論やリファクタリング機能（変数名の一括変更など）が
      // 使えなくなる場合があります。もし補完が物足りないと感じたら、vtsls だけは残しておくのも一つの手です
      "language_servers": [
        "biome",
        "!eslint",
        "!vtsls"
      ]
    },
    "Jinja2": {
      "tab_size": 2
    },
    "Python": {
      "code_actions_on_format": {
        "source.fixAll": true
      },
      "formatter": "language_server",
      "language_servers": [
        "ruff"
      ],
      "tab_size": 4
    },
    "TypeScript": {
      "language_servers": [
        "biome",
        "!eslint",
        "!vtsls"
      ]
    }
  },
  // 改行コードは LF 強制
  "line_ending": "enforce_lf",
  "linked_edits": true,
  // AI 機能を無効にする場合に true にする
  // "disable_ai": true,
  "minimap": {
    "show": "always"
  },
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "left"
  },
  "show_signature_help_after_edits": false,
  // ステータスバーの表示設定
  "status_bar": {
    // 改行コードを表示させる(設定名が変更される恐れあり)
    "line_endings_button": true
  },
  "telemetry": {
    "anthropic_retention": false,
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "font_family": "Hack Nerd Font",
    "max_scroll_history_lines": 10000,
    "shell": {
      "program": "pwsh.exe"
    }
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "One Light",
    "mode": "dark"
  },
  // こっちは UI 全体の設定
  "ui_font_size": 12,
  // 120文字目と200文字目にルーラーをひく
  "wrap_guides": [
    120,
    200
  ]
}